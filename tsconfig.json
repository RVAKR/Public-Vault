{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "src/main.ts",
    "src/app.ts",
    "src/crypto.ts",
    "src/form.ts",
    "src/store.ts",
    "src/types.ts",
    "src/ui.ts"
  ]
}
