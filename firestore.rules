rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile validation
    match /users/{userId} {
      allow read, write: if isValidId(userId) && isOwner(userId);

      // Encrypted vault subcollection
      match /vault/{vaultDocId} {
        allow read, write: if isValidId(userId) && isOwner(userId);
      }

      // Archive log subcollection
      match /archives/{archiveId} {
        allow read, write: if isValidId(userId) && isOwner(userId) && isValidId(archiveId);
      }
    }
  }
}
