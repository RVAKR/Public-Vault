{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile authenticated with Google Workspace SSO",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "createdAt"]
    },
    "UserVaultRecord": {
      "title": "UserVaultRecord",
      "description": "Encrypted user vault payload with zero-knowledge metadata stored in Firestore free tier",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "salt": { "type": "string", "maxLength": 256 },
        "verifier": { "type": "string", "maxLength": 1024 },
        "verifierIv": { "type": "string", "maxLength": 128 },
        "ciphertext": { "type": "string" },
        "iv": { "type": "string", "maxLength": 128 },
        "passwordHint": { "type": "string", "maxLength": 256 },
        "autoLockMinutes": { "type": "number" },
        "itemCount": { "type": "number" },
        "version": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "salt", "verifier", "verifierIv", "ciphertext", "iv", "updatedAt"]
    },
    "MonthlyArchiveRecord": {
      "title": "MonthlyArchiveRecord",
      "description": "Log of monthly credential and document archive zip generation and email dispatch",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "recipientEmail": { "type": "string", "maxLength": 256 },
        "archiveName": { "type": "string", "maxLength": 256 },
        "itemCount": { "type": "number" },
        "fileCount": { "type": "number" },
        "status": { "type": "string", "enum": ["created", "downloaded", "dispatched", "pending"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "recipientEmail", "archiveName", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Per-user Google authenticated profile document"
    },
    "/users/{userId}/vault/current": {
      "schema": "UserVaultRecord",
      "description": "Per-user encrypted vault blob synced to Firestore"
    },
    "/users/{userId}/archives/{archiveId}": {
      "schema": "MonthlyArchiveRecord",
      "description": "Monthly archive metadata records"
    }
  }
}
